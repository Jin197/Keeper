# =====================================================
# Keeper — Environment variables
# Copy this file to .env.local and fill in real values.
# =====================================================

# ----- Public app -----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Supabase (Phase 3a) -----
# Get these from https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only — NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ----- Google Cloud Vision OCR (Phase 3b) -----
# 1. Create a project at https://console.cloud.google.com
# 2. Enable the Vision API
# 3. Create a service account, download JSON key
# 4. Paste the entire JSON content as a single line below
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ----- Stripe (Phase 3c) -----
# Get these from https://dashboard.stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Get this from https://dashboard.stripe.com → Developers → Webhooks (after creating an endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...
# Prices — see docs/LAUNCH.md §Stripe. One product ("Pro"), three price bands
# (A = high-income, B = mid, C = low; mapping in lib/pricing.ts). Band A is
# required; B and C fall back to A when unset. Give every Price
# `currency_options` for the currencies listed in lib/pricing.ts so Checkout
# can charge in the buyer's currency.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_MONTHLY_B=
STRIPE_PRICE_YEARLY_B=
STRIPE_PRICE_MONTHLY_C=
STRIPE_PRICE_YEARLY_C=
# One-off "certified sale dossier" (mode: payment). Optional; the buy button
# hides itself when unset. Same _B / _C fallback rule.
STRIPE_PRICE_SALE_DOSSIER=
STRIPE_PRICE_SALE_DOSSIER_B=
STRIPE_PRICE_SALE_DOSSIER_C=

# ----- Vehicle data (all optional — features degrade gracefully) -----
# UK plate lookup: DVLA Vehicle Enquiry Service (free key)
# https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=
# UK MOT history: DVSA MOT History API (free; register, receive OAuth
# client credentials + an API key by email) https://documentation.history.mot.api.gov.uk/
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
MOT_SCOPE_URL=https://tapi.dvsa.gov.uk/.default
MOT_API_KEY=
# France plate lookup via a SIV reseller (paid; optional). Any provider with a
# GET ?immatriculation=&token= contract works — see lib/vehicle-lookup/providers/siv-france.ts
SIV_API_URL=
SIV_API_KEY=
# Germany live fuel prices: Tankerkönig (free key) https://creativecommons.tankerkoenig.de/
TANKERKOENIG_API_KEY=
# France live fuel prices need no key (open data). US recalls/complaints (NHTSA) need no key.

# ----- Affiliate / partner tracking (optional; links work untracked) -----
NEXT_PUBLIC_AFFILIATE_AUTODOC_ID=
NEXT_PUBLIC_AFFILIATE_AMAZON_TAG=
# Per-country tracked insurance-comparison deep links, e.g. _GB, _FR, _US
NEXT_PUBLIC_AFFILIATE_INSURANCE_URL_GB=
NEXT_PUBLIC_AFFILIATE_INSURANCE_URL_FR=
NEXT_PUBLIC_AFFILIATE_INSURANCE_URL_US=

# ----- Upstash Redis (rate limiting + lookup cache; optional) -----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Sentry (Phase 5, optional) -----
# Get a DSN at https://sentry.io → your project → Settings → Client Keys
# If empty, Sentry stays disabled (build still works).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ----- RLS audit (Phase 5, optional) -----
# Two test users used by tests/audit/rls-audit.mjs
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=

# ----- Crons & email (reminders) -----
# Vercel injects `Authorization: Bearer <CRON_SECRET>` on cron calls (vercel.json).
CRON_SECRET=
# Resend — reminder emails. Leave empty to keep reminders in-app only.
RESEND_API_KEY=
EMAIL_FROM="Keeper <reminders@keeperapp.app>"

# ----- Legal identity (imprint) -----
# REQUIRED before offering the service commercially. The imprint shows a
# warning until name + address + email are set, and never invents a company
# registration or VAT number. See lib/legal/entity.ts.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_FORM=
LEGAL_ENTITY_CAPITAL=
LEGAL_ENTITY_REGISTRY=
LEGAL_ENTITY_VAT=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_PUBLISHER=
LEGAL_ENTITY_EMAIL=
LEGAL_ENTITY_DPO_EMAIL=
